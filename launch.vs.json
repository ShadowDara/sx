{
  "configurations": [
    {
      "type": "default",
      "name": "sx.exe help",
      "project": "CMakeLists.txt",
      "projectTarget": "sx.exe",
      "args": [
        "-h"
      ]
    },
    {
      "type": "default",
      "name": "sx.exe info",
      "project": "CMakeLists.txt",
      "projectTarget": "sx.exe",
      "args": [
        "-i"
      ]
    },
    {
      "type": "default",
      "name": "sx.exe version",
      "project": "CMakeLists.txt",
      "projectTarget": "sx.exe",
      "args": [
        "-v"
      ]
    },
    {
      "type": "default",
      "name": "sx-multi.exe help",
      "project": "CMakeLists.txt",
      "projectTarget": "sx-multi.exe",
      "args": [
        "-h"
      ]
    },
    {
      "type": "default",
      "name": "NumberGame",
      "project": "CMakeLists.txt",
      "projectTarget": "sx-multi.exe",
      "args": [
        "--numberguess"
      ]
    },
    {
      "type": "default",
      "name": "Loadtime",
      "project": "CMakeLists.txt",
      "projectTarget": "sx-multi.exe",
      "args": [
        "--loadtime"
      ]
    },
    {
      "type": "default",
      "name": "Loadtime Full Conf",
      "project": "CMakeLists.txt",
      "projectTarget": "sx-multi.exe",
      "args": [
        "--loadtime",
        "\"C:/Users/schueler/source/repos/Shortcuter/example_sx.conf\""
      ],
      "cwd": "${workspaceRoot}"
    }
  ],
  "defaults": {},
  "version": "0.2.1"
}